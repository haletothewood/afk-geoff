diff --git a/label.js b/label.js
index eb5423b..ee24698 100644
--- a/label.js
+++ b/label.js
@@ -1,3 +1,6 @@
 export function normalizeLabel(value) {
-  return value.trim().toLowerCase();
+  if (typeof value !== 'string') {
+    throw new TypeError('Label must be a string');
+  }
+  return value.trim().toLowerCase().replace(/\s+/g, ' ');
 }
diff --git a/label.test.js b/label.test.js
index da72ae4..223ff75 100644
--- a/label.test.js
+++ b/label.test.js
@@ -2,3 +2,20 @@ import { test } from 'node:test';
 import assert from 'node:assert/strict';
 import { normalizeLabel } from './label.js';
 test('trims and lowercases labels', () => { assert.equal(normalizeLabel('  HeLLo  '), 'hello'); });
+
+test('collapses internal JavaScript whitespace to ASCII spaces', () => {
+  assert.equal(normalizeLabel('  HeLLo   WORLD\t\tfrom\n\r JavaScript  '), 'hello world from javascript');
+  assert.equal(normalizeLabel('A\v\fB\u00a0\u2003C\u2028\u2029D\ufeffE'), 'a b c d e');
+});
+
+test('returns an empty string for empty or whitespace-only labels', () => {
+  for (const value of ['', '   ', '\t\n\r\v\f\u00a0\u2003\u2028\u2029\ufeff']) {
+    assert.equal(normalizeLabel(value), '');
+  }
+});
+
+test('rejects non-string inputs with TypeError', () => {
+  for (const value of [undefined, null, 0, true, 1n, Symbol('label'), [], {}, new String('label'), { trim: () => 'label' }]) {
+    assert.throws(() => normalizeLabel(value), TypeError);
+  }
+});
